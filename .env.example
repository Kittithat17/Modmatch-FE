# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# .env.local ถูก gitignore ไว้ ห้าม commit ค่าจริงขึ้น repo เด็ดขาด

# URL ของ backend ตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ จะถูกฝังลงไปใน bundle ฝั่ง client
# แปลว่าใครก็เห็นค่าได้ ห้ามใส่ secret ในตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
