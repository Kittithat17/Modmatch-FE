# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real values to the repo.

# Backend URL. Variables prefixed with NEXT_PUBLIC_ are inlined into the
# client bundle, so anyone can read them. Never put a secret behind a
# NEXT_PUBLIC_ name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
